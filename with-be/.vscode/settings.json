{
  "[dockerfile]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },
  "cSpell.words": [
    "addgroup",
    "adduser",
    "autocrlf",
    "credentialless",
    "daniele",
    "delgroup",
    "deluser",
    "elif",
    "iccicci",
    "memtime",
    "nvmrc",
    "parens",
    "pgdata",
    "phong",
    "ricci",
    "unproject",
    "vite"
  ],
  "editor.codeActionsOnSave": ["source.formatDocument", "source.fixAll.eslint", "source.fixAll.eslint"],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.nodePath": "./node_modules/.bin/eslint",
  "eslint.options": { "overrideConfigFile": "./eslint.config.js" },
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  "explorer.confirmDelete": false,
  "files.associations": { "Makefile*": "makefile" },
  "files.autoSave": "off",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "json.schemaDownload.enable": true
}
